rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /saves/{saveId} {
      allow read: if true;

      // Первое создание нового сейва при начальной инициализации
      // Разрешаем клиенту создавать документ ТОЛЬКО с косметическими полями.
      // Экономика, блобы и энергия инициализируются и управляются исключительно сервером (Admin SDK).
      allow create: if
        request.resource.data.rev == 1 &&
        request.resource.data.keys().hasOnly([
          'playerName',
          'selectedId',
          'expPickId',
          'expPickIds',
          'lastUpdated',
          'rev'
        ]);

      // Обновление с клиента разрешено ТОЛЬКО для клиентских/косметических полей (playerName, selectedId, expPickId, expPickIds)
      // Все экономические и прогрессионные поля (cubes, blobs, energy, totalCubesAllTime, arenaSquadIds и т.д.) заблокированы.
      // rev должен увеличиваться строго на 1 для работы оптимистичной блокировки.
      allow update: if
        resource != null &&
        request.resource.data.rev == resource.data.rev + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'playerName',
          'selectedId',
          'expPickId',
          'expPickIds',
          'lastUpdated',
          'rev'
        ]);

      allow delete: if false;
    }

    match /nodes/{nodeId} {
      allow read: if true;
      allow write: if false; // Только через /api/claim.ts (type: attack_node, node)
    }

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if false; // Было write:if true — любой мог переписать таблицу из devtools
    }

    match /og_badges/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Legacy-коллекция от прошлой идеи арены. Была открыта на запись всем;
    // закрыта, актуальная арена живёт в arena_squads / arena_matches / arena_seasons.
    match /arena/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── ARENA (см. ARENA.md) ───
    // Читать может любой (лидерборд, лента матчей), писать — только Admin SDK
    // через /api/claim.ts: бой, рейтинг и награды считает исключительно сервер.
    match /arena_squads/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /arena_matches/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /arena_seasons/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /reactor_global/{docId} {
      allow read: if true;
      allow write: if false; // Пишется только через /api/claim.ts или /api/reactor-close.ts (Firebase Admin SDK)
    }

    match /reactor_contributions/{docId} {
      allow read: if true;
      allow write: if false; // Пишется только через /api/claim.ts (Firebase Admin SDK)
    }

    match /reactor_events_archive/{docId} {
      allow read: if true;
      allow write: if false; // Архив сезонов реактора (только Admin SDK)
    }

    match /summon_tx_used/{docId} {
      allow read: if false;
      allow write: if false; // Защита от повторного использования txHash призывов за USDC
    }
  }
}
